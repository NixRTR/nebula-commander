<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <?define Version = "0.0.0" ?>
  <Package Name="Nebula Commander"
           Manufacturer="NixRTR"
           Version="$(var.Version)"
           UpgradeCode="A7B8C9D0-E1F2-4A5B-8C9D-0E1F2A3B4C5D"
           Language="1033"
           Codepage="1252"
           InstallerVersion="500"
           Compressed="yes"
           Scope="perMachine">
    <SummaryInformation Codepage="1252" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Nebula Commander is already installed." />
    <Media Id="1" Cabinet="NebulaCommander.cab" EmbedCab="yes" />
    <Property Id="ARPHELPLINK" Value="https://github.com/NixRTR/nebula-commander" />
    <Property Id="ARPPRODUCTICON" Value="NcclientExe" />
    <Icon Id="NcclientExe" SourceFile="redist\ncclient.exe" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="Nebula Commander" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="Nebula Commander" />
    </StandardDirectory>

    <!-- %ProgramData%\nebula-commander - shared state (settings.json, the DPAPI-encrypted
         device token, status.json, the downloaded nebula.exe, and Nebula's own
         config.yaml/dns-client.json/nebula.log) that both the LocalSystem service and the
         unelevated tray need to read/write. See client/windows/shared_paths.py. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="SHAREDDATADIR" Name="nebula-commander" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Nebula Commander" Level="1" ConfigurableDirectory="INSTALLDIR">
      <ComponentGroupRef Id="MainComponents" />
      <ComponentRef Id="SharedDataFolderPermissions" />
    </Feature>

    <Feature Id="AddToPath"
             Title="Add install directory to PATH"
             Description="Allows running ncclient from any command prompt."
             Level="2">
      <ComponentRef Id="PathEnvironment" />
    </Feature>

    <ComponentGroup Id="MainComponents" Directory="INSTALLDIR">
      <Component Id="NcclientExe" Guid="B1C2D3E4-F5A6-4B7C-8D9E-0F1A2B3C4D5E">
        <File Id="NcclientExe"
              Source="redist\ncclient.exe"
              KeyPath="yes">
          <Shortcut Id="NcclientStartMenuShortcut"
                    Name="Nebula Commander (CLI)"
                    Description="Nebula Commander command-line client"
                    Directory="ProgramMenuDir"
                    WorkingDirectory="INSTALLDIR" />
        </File>
      </Component>
      <Component Id="NcclientTrayExe" Guid="C2D3E4F5-A6B7-4C8D-9E0F-1A2B3C4D5E6F">
        <File Id="NcclientTrayExe"
              Source="redist\ncclient-tray.exe"
              KeyPath="yes">
          <Shortcut Id="TrayStartMenuShortcut"
                    Name="Nebula Commander Tray"
                    Description="Nebula Commander system tray application"
                    Directory="ProgramMenuDir"
                    WorkingDirectory="INSTALLDIR" />
        </File>
      </Component>
      <!-- The service that actually polls Nebula Commander and runs Nebula, as
           LocalSystem (already fully privileged - no UAC prompt needed). Installed/
           started on install, stopped on upgrade/uninstall, removed on uninstall. -->
      <Component Id="NcclientServiceExe" Guid="E4F5A6B7-C8D9-4E0F-1A2B-3C4D5E6F7A8B">
        <File Id="NcclientServiceExe"
              Source="redist\ncclient-service.exe"
              KeyPath="yes" />
        <ServiceInstall Id="NebulaCommanderServiceInstall"
                         Type="ownProcess"
                         Name="NebulaCommanderService"
                         DisplayName="Nebula Commander"
                         Description="Polls Nebula Commander for config/certs and runs the Nebula mesh VPN daemon."
                         Start="auto"
                         Account="LocalSystem"
                         ErrorControl="normal" />
        <ServiceControl Id="NebulaCommanderServiceControl"
                         Name="NebulaCommanderService"
                         Start="install"
                         Stop="both"
                         Remove="uninstall"
                         Wait="yes" />
      </Component>
    </ComponentGroup>

    <!-- Create %ProgramData%\nebula-commander with an ACL granting local Users
         modify rights, so the unelevated tray can write settings.json/token.bin/
         nebula\nebula.exe there while the LocalSystem service reads/writes freely.
         Nothing else lives in this folder beyond app state for this one product, so
         a broad grant within it is an acceptable, deliberate tradeoff (see notes in
         client/token_store.py on what machine-scope DPAPI does and doesn't protect
         against). -->
    <DirectoryRef Id="SHAREDDATADIR">
      <Component Id="SharedDataFolderPermissions" Guid="F5A6B7C8-D9E0-4F1A-2B3C-4D5E6F7A8B9C">
        <CreateFolder>
          <util:PermissionEx User="Users" GenericAll="yes" />
        </CreateFolder>
        <RemoveFolder Id="RemoveSharedDataFolder" On="uninstall" />
        <RegistryValue Root="HKLM"
                        Key="Software\NixRTR\NebulaCommander"
                        Name="SharedDataFolderInstalled"
                        Type="integer"
                        Value="1"
                        KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- By default only Administrators can start/stop/query a Windows service via
         the Service Control Manager - grant Authenticated Users the same rights
         (plus the harmless read-only ones) so the tray's Start/Stop/Restart Service
         menu items work without a UAC prompt. Deferred, elevated (Impersonate="no")
         custom action run once, after the service is registered and started.
         NEEDS VERIFICATION ON A REAL WINDOWS MACHINE: run `sc sdshow
         NebulaCommanderService` after install to confirm the ACL applied as
         intended, and confirm Start/Stop/Restart from the tray actually avoids a
         UAC prompt. -->
    <CustomAction Id="GrantServiceControlAcl"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]sc.exe&quot; sdset NebulaCommanderService &quot;D:(A;;CCLCSWRPWPDTLOCRRC;;;SY)(A;;CCDCLCSWRPWPDTLOCRSDRCWDWO;;;BA)(A;;CCLCSWRPWPLORC;;;AU)&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="GrantServiceControlAcl" After="StartServices">NOT Installed</Custom>
    </InstallExecuteSequence>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="PathEnvironment" Guid="D3E4F5A6-B7C8-4D9E-0F1A-2B3C4D5E6F7A">
        <Environment Id="PathEnv"
                     Name="PATH"
                     Action="set"
                     Part="last"
                     Permanent="no"
                     System="yes"
                     Value="[INSTALLDIR]" />
      </Component>
    </DirectoryRef>
  </Package>
</Wix>
