#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    # Automatic updates (client/linux/auto_update.py): stop the timer and drop
    # its window, which ncclient wrote outside the package's own files.
    if [ -d /run/systemd/system ]; then
        systemctl disable --now ncclient-update.timer 2>/dev/null || true
    fi
    rm -rf /etc/systemd/system/ncclient-update.timer.d
    # Split-horizon DNS (client/dns_apply.py). ncclient leaves its NetworkManager
    # drop-ins in place while it runs: removing them at runtime would let
    # NetworkManager take over the tun device of every other ncclient instance.
    nm_changed=
    for f in /etc/NetworkManager/conf.d/90-nebula-commander-dns.conf \
             /etc/NetworkManager/conf.d/91-nebula-commander-unmanaged.conf \
             /etc/NetworkManager/dnsmasq.d/nebula-commander*.conf; do
        if [ -e "$f" ]; then
            rm -f "$f"
            nm_changed=1
        fi
    done
    if [ -n "$nm_changed" ] && command -v nmcli >/dev/null 2>&1; then
        nmcli general reload conf 2>/dev/null || true
    fi
    dnsmasq_changed=
    for f in /etc/dnsmasq.d/nebula-commander*.conf; do
        if [ -e "$f" ]; then
            rm -f "$f"
            dnsmasq_changed=1
        fi
    done
    if [ -n "$dnsmasq_changed" ] && [ -d /run/systemd/system ]; then
        systemctl try-restart dnsmasq 2>/dev/null || true
    fi
    # Subnet router / exit gateway rules (client/linux_routing.py): one nftables
    # table per tun device, plus DOCKER-USER rules tagged "ncclient[:<dev>]".
    if command -v nft >/dev/null 2>&1; then
        for t in $(nft list tables 2>/dev/null | awk '$2 == "inet" && $3 ~ /^ncclient_routing/ {print $3}'); do
            nft delete table inet "$t" 2>/dev/null || true
        done
    fi
    for ipt in iptables iptables-legacy; do
        command -v "$ipt" >/dev/null 2>&1 || continue
        "$ipt" -w -S DOCKER-USER 2>/dev/null | grep -E -- '--comment "?ncclient' | sed 's/^-A /-D /' |
            while read -r rule; do eval "\"$ipt\" -w $rule" 2>/dev/null || true; done
    done
fi

if [ "$1" = "purge" ]; then
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        # Debian 12's polkit.service has no ExecReload= at all (confirmed
        # directly) - see postinst for the fuller explanation.
        systemctl reload polkit 2>/dev/null || systemctl try-restart polkit 2>/dev/null || true
        systemctl reload dbus 2>/dev/null || true
    fi
    # Deliberately does not remove /var/lib/ncclient: it holds the device's
    # enrollment token/certs, which the admin should remove explicitly
    # rather than have a purge do silently. (No group to worry about
    # cleaning up either way - unlike an earlier version of this package,
    # nothing here creates a nebula-commander system group anymore.)
fi

exit 0
