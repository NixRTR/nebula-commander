<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  Declares client/linux/dbus_server.py's two D-Bus actions.

  .read (status, offered routes, key-redacted config) defaults to
  allow_active=yes: any user with an active local session can look.

  .manage (settings, enrollment, routes/exit node) defaults to
  auth_admin_keep: an administrator's password. The shipped rules file
  (../rules.d/org.nixrtr.nebulacommander.rules) is what grants members of
  sudo/wheel the no-password path; this default is the fallback if that
  rules file is ever missing, so a broken install fails closed rather than
  letting any local user change the device's network.

  allow_inactive/allow_any stay "no" for both: background and remote (SSH)
  sessions get nothing.
-->
<policyconfig>
  <vendor>NixRTR</vendor>
  <vendor_url>https://github.com/NixRTR/nebula-commander</vendor_url>

  <action id="org.beardedtek.NebulaCommander1.read">
    <description>Read Nebula Commander device status</description>
    <message>Authentication is required to read Nebula Commander device status</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.beardedtek.NebulaCommander1.manage">
    <description>Manage Nebula Commander device settings, enrollment, and routes</description>
    <message>Authentication is required to change Nebula Commander device settings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
