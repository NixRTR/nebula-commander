[Unit]
Description=Nebula Commander client automatic update
Documentation=https://nebulacdr.com/docs/usage/ncclient/auto-update/
After=network-online.target
Wants=network-online.target

# Started by ncclient-update.timer (only enabled when an administrator turns on
# automatic updates - see client/linux/auto_update.py), or by "Check now".
# A unit of its own, so the package upgrade restarting ncclient.service can't kill it.
[Service]
Type=oneshot
Environment=NEBULA_COMMANDER_CONFIG_DIR=/var/lib/ncclient
Environment=NEBULA_COMMANDER_INSTALL_KIND=package
ExecStart=/usr/bin/ncclient auto-update run-upgrade
UMask=0077
TimeoutStartSec=1h
