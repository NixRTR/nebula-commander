<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NebulaCommanderApp.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NebulaCommanderApp.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="20" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <!-- Connection -->
            <StackPanel Spacing="12">
                <TextBlock Text="Connection" Style="{StaticResource SubtitleTextBlockStyle}" />

                <TextBox
                    x:Name="ServerBox"
                    Header="Server URL"
                    PlaceholderText="https://nebula-commander.example.com" />

                <NumberBox
                    x:Name="IntervalBox"
                    Header="Poll interval (seconds)"
                    Minimum="10"
                    Maximum="3600"
                    SpinButtonPlacementMode="Inline"
                    SmallChange="10"
                    LargeChange="60" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBox
                        x:Name="NebulaPathBox"
                        Header="Nebula executable path (optional)"
                        PlaceholderText="Leave empty to use nebula from system PATH"
                        Width="360" />
                    <Button
                        x:Name="BrowseButton"
                        Content="Browse..."
                        VerticalAlignment="Bottom"
                        Click="BrowseButton_Click" />
                </StackPanel>

                <ToggleSwitch
                    x:Name="AcceptDnsToggle"
                    Header="Split-horizon DNS"
                    OnContent="Apply DNS overrides from the network"
                    OffContent="Do not apply DNS overrides" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click" />
                    <ProgressRing x:Name="SaveProgress" IsActive="False" Width="18" Height="18" />
                </StackPanel>

                <InfoBar x:Name="SaveResultBar" IsOpen="False" IsClosable="False" />
            </StackPanel>

            <!-- Nebula binary -->
            <StackPanel Spacing="12">
                <TextBlock Text="Nebula binary" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="NebulaVersionText" TextWrapping="Wrap" Opacity="0.85" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="CheckUpdateButton" Content="Check for updates" Click="CheckUpdateButton_Click" />
                    <Button x:Name="DownloadButton" Content="Download / update Nebula" IsEnabled="False" Click="DownloadButton_Click" />
                    <ProgressRing x:Name="NebulaProgress" IsActive="False" Width="18" Height="18" />
                </StackPanel>
                <InfoBar x:Name="NebulaResultBar" IsOpen="False" IsClosable="False" />
            </StackPanel>

            <!-- Startup -->
            <StackPanel Spacing="12">
                <TextBlock Text="Startup" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch
                    x:Name="RunOnStartupToggle"
                    Header="Run on startup"
                    OnContent="Nebula Commander opens (to the tray) after you log in"
                    OffContent="Nebula Commander does not open automatically"
                    Toggled="RunOnStartupToggle_Toggled" />
                <TextBlock
                    Text="The mesh VPN itself always runs via the Nebula Commander service, independent of this setting."
                    TextWrapping="Wrap"
                    Opacity="0.7" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
