<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NebulaCommanderApp.Pages.NetworksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NebulaCommanderApp.Pages"
    xmlns:controls="using:NebulaCommanderApp.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="DotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="Gray" />
        </Style>
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="/Assets/Logo.png" Width="36" Height="36" />
                <TextBlock Text="Networks" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click" Margin="12,0,0,0" VerticalAlignment="Center" />
                <Button x:Name="AddNetworkButton" Content="Add network" Click="AddNetworkButton_Click" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Service -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Nebula Commander Service" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="ServiceDot" Style="{StaticResource DotStyle}" />
                        <TextBlock x:Name="ServiceStateText" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ServiceStartButton" Content="Start" Click="ServiceStartButton_Click" />
                        <Button x:Name="ServiceStopButton" Content="Stop" Click="ServiceStopButton_Click" />
                        <Button x:Name="ServiceRestartButton" Content="Restart" Click="ServiceRestartButton_Click" />
                        <ProgressRing x:Name="ServiceProgress" IsActive="False" Width="16" Height="16" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ServiceActionResult" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- One card per enrolled network (built in code), clickable -->
            <TextBlock
                Text="Each network this device is enrolled in. Open one for its routes, exit node and DNS."
                Style="{StaticResource MutedTextStyle}"
                TextWrapping="Wrap" />
            <StackPanel x:Name="NetworksPanel" Spacing="8" />
            <InfoBar
                x:Name="NoNetworksBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Informational"
                Title="Not enrolled in any network"
                Message="Use Add network with an enrollment code from Nebula Commander (Nodes, then Get Enrollment Code)." />
            <controls:CloudPromo x:Name="CloudPromo" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
