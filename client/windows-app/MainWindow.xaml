<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NebulaCommanderApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NebulaCommanderApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="NebulaCommanderApp"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="NebulaCommanderApp"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Status"
                    Tag="status">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Enrollment" Tag="enrollment">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FB;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Shown while unelevated: reading works for everyone, but every
                     change needs an elevated administrator (the service checks). -->
                <InfoBar
                    x:Name="AdminBar"
                    Margin="24,12,24,0"
                    Severity="Informational"
                    IsOpen="False"
                    IsClosable="True"
                    Title="View only"
                    Message="Changing settings, enrollment, routes or the service requires an administrator.">
                    <!-- In Content, not InfoBar.ActionButton: the ActionButton slot
                         isn't in the keyboard tab order (verified on Win11 25H2),
                         which left keyboard-only users no way to elevate. -->
                    <Button
                        x:Name="RelaunchButton"
                        Margin="0,0,0,12"
                        AccessKey="R"
                        Content="Relaunch as administrator"
                        Click="RelaunchElevated_Click" />
                </InfoBar>
                <Frame x:Name="NavFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
