<?xml version="1.0" encoding="utf-8" ?>
<!-- Small Nebula Commander Cloud ad: shown on the Add network page and on the
     Networks page while no network is enrolled. Brand colours (purple 700-950,
     gold 300/400) are fixed so it looks the same in light and dark theme. -->
<UserControl
    x:Class="NebulaCommanderApp.Controls.CloudPromo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button
        x:Name="PromoButton"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Padding="0"
        Click="PromoButton_Click"
        PointerEntered="PromoButton_PointerEntered"
        PointerExited="PromoButton_PointerExited"
        AutomationProperties.Name="Nebula Commander Cloud: your mesh, without the maintenance. Learn more"
        ToolTipService.ToolTip="cloud.nebulacdr.net/pricing">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
            </ControlTemplate>
        </Button.Template>

        <Border CornerRadius="10" Padding="16,14" BorderThickness="1" BorderBrush="#2ED0B84A">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.3" EndPoint="1,0.7">
                    <GradientStop Color="#4D0C7D" Offset="0" />
                    <GradientStop Color="#33055D" Offset="0.45" />
                    <GradientStop Color="#14051F" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/Logo.png" Width="40" Height="40" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="NEBULA COMMANDER CLOUD" Foreground="#D0B84A" FontSize="11" FontWeight="Bold" CharacterSpacing="140" />
                    <TextBlock Text="Your mesh, without the maintenance." Foreground="#F4EEFB" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Hosted, backed up and kept up to date for you." Foreground="#CDBFE0" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <Border x:Name="Pill" Grid.Column="2" Background="#D0B84A" CornerRadius="14" Padding="14,6" VerticalAlignment="Center">
                    <TextBlock Text="Learn more →" Foreground="#14051F" FontSize="12.5" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>
    </Button>
</UserControl>
